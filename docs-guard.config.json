    "docs",
    "templates"
  ],
  "archivePolicy": {
    "roots": [
      "docs/history"
    ],
    "requiredMarker": "ARCHIVE — 현재 SSOT 아님"
  },
  "projectsTable": {
    "file": "PROJECTS.md",
    "requiredColumns": [
      "프로젝트",
      "상태",
      "기본 브랜치",
      "원격(origin)",
      "STATUS 포인터"
    ],
    "statusPointerColumn": "STATUS 포인터"
  },
  "allowedStatusPointerSentinels": [
    "(본 저장소 — 운영 허브)",
    "(미작성)"
  ],
  "statusPointerRules": {
    "repoRelative": {
      "mustEndWith": "STATUS.md",
      "denyLeadingSlash": true,
      "denyBackslash": true,
      "denyDotDot": true,
      "existenceCheckWhenSelfProject": true
    },
    "url": {
      "allow": true,
      "recommended": false,
      "requireScheme": [
        "http://",
        "https://"
      ],
      "network": false,
      "onValid": "warn"
    }
  },
  "autoDocs": {
    "configFile": "auto-docs.config.json",
    "approvalsFile": "DOC_APPROVALS.md",
    "approvalsTable": {
      "requiredColumns": [
        "approval_id",
        "status",
        "approved_by",
        "approved_at",
        "last_changed_at",
        "last_changed_by",
        "repository",
        "document",
        "block_id",
        "mode",
        "allowed_triggers",
        "allowed_updates",
        "forbidden_updates",
        "required_checks",
        "linked_config",
        "linked_commit_or_pr",
        "notes"
      ],
      "blockIdColumn": "block_id",
      "statusColumn": "status"
    },
    "markerScanTargets": [
      "README.md",
      "docs/playbooks/DOCUMENTATION_MAINTENANCE.md"
