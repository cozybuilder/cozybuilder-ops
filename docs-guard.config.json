  "documentContracts": [
    {
      "path": "GLOBAL.md",
      "allowedH2": [
        "1. 헌법의 범위",
        "2. 핵심 원칙",
        "3. 권한과 승인",
        "4. 안전·데이터 불변식",
        "5. 핵심 문서 소유권",
        "6. 저장소·변경 규약",
        "7. 기준의 변경",
        "8. OS 버전"
      ],
      "forbiddenRegex": [
        "20[0-9]{2}-[0-9]{2}-[0-9]{2}",
        "✅"
      ]
    },
    {
      "path": "PLAYBOOK.md",
      "allowedH2": [
        "P0. 필수 진입 순서",
        "P1. 공통 실행 흐름",
        "P2. 절차 라우터",
        "P3. 완료 계약",
        "P4. 문서 변경 최소 절차"
      ],
      "forbiddenRegex": [
        "20[0-9]{2}-[0-9]{2}-[0-9]{2}",
        "## P[5-9]|## P1[0-9]"
      ]
    },
    {
      "path": "PROJECTS.md",
      "allowedH2": [
        "등록 상태 범례",
        "등록부",
        "관리 규칙"
      ],
      "forbiddenH2": [
        "운영 메모",
        "변경 이력",
        "완료 내역"
      ]
    },
    {
      "path": "templates/project-template/docs/AI_CONTEXT.md",
      "maxBytes": 16384,
      "requiredH2": [
        "제품 정의",
        "확정 범위",
        "제품·데이터 불변식",
        "기술 기준",
        "안전·금지선",
        "문서 라우팅"
      ],
      "forbiddenH2": [
        "현재 상태",
        "변경 이력",
        "완료 내역",
        "검증 로그"
      ]
    },
    {
      "path": "templates/project-template/docs/STATUS.md",
      "maxBytes": 12288,
      "requiredH2": [
        "기준",
        "진행 중",
        "OPEN / BLOCKED",
        "최신 검증 기준",
        "승인된 다음 작업",
        "최근 완료"
      ],
      "forbiddenH2": [
        "변경 이력",
        "작업 이력",
        "전체 완료",
        "상세 검증"
      ]
    }
  ],
