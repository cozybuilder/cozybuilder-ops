{
  "_comment": "Auto Documentation Sync capability. 권한은 DOC_APPROVALS.md. active 승인+구현 generator+마커가 모두 일치할 때만 수동 실행.",
  "schemaVersion": 2,
  "runtime": "manual-local-v1",
  "markerFormat": "<!-- AUTO-DOCS:START:<block_id> --> ... <!-- AUTO-DOCS:END:<block_id> -->",
  "blocks": [
    {
      "block_id": "ops-doc-map",
      "repository": "cozybuilder-ops",
      "document": "README.md",
      "mode": "regenerate",
      "triggers": ["rootRequiredDocs change", "root doc add or remove"],
      "dataSource": "docs-guard.config.json#rootRequiredDocs",
      "generator": "ops-doc-map",
      "tier": "manual"
    },
    {
      "block_id": "playbook-automation-index",
      "repository": "cozybuilder-ops",
      "document": "docs/playbooks/DOCUMENTATION_MAINTENANCE.md",
      "mode": "regenerate",
      "triggers": ["script or workflow add"],
      "dataSource": "scripts-workflows",
      "generator": "playbook-automation-index",
      "tier": "manual"
    }
  ]
}
